<% layout("/listings/layouts/boilerplate") %>

<div class="row">
    <div class="col-8 offset-2">

        <h3>Create a New Listing</h3>
<form method="POST" action="/listings" class="needs-validation" novalidate>
        <!-- <form method="POST" action="/listings" novalidate class="needs-validation"> -->

            <!-- Title -->
            <div class="mb-3">
                <label for="title" class="form-label">Title</label>
                <input
                    name="listing[title]"
                    placeholder="Enter title"
                    type="text"
                    class="form-control"
                    required
                />
                <div class="invalid-feedback">
        Please enter a title.
            </div>
            
    </div>


            <!-- Description -->
            <div class="mb-3">
                <label for="description" class="form-label">Description</label>
                <textarea
                    name="listing[description]"
                    placeholder="Enter description"
                    class="form-control"
                    required
                ></textarea>
                 <div class="invalid-feedback">
        give description.
            </div>
           
    </div>


            <!-- Image -->
            <div class="mb-3">
                <label for="image" class="form-label">Image Link</label>
                <input
                    name="listing[image]"
                    placeholder="Enter image URL/Link"
                    type="text"
                    class="form-control"
                />
            </div>
            
    </div>


            <!-- Price -->
            <div class="mb-3">
                <label for="price" class="form-label">Price</label>
                <input
                    name="listing[price]"
                    placeholder="Enter price"
                    type="text"
                    class="form-control"
                    required
                />
                 <div class="invalid-feedback">
        Please enter a valid price.
            </div>
            
    </div>


            <!-- Country -->
            <div class="mb-3">
                <label for="country" class="form-label">Country</label>
                <input
                    name="listing[country]"
                    placeholder="Enter country"
                    type="text"
                    class="form-control"
                    required
                />
                 <div class="invalid-feedback">
        Please enter a country.
            </div>
           
    </div>


            <!-- Location -->
            <div class="mb-3">
                <label for="location" class="form-label">Location</label>
                <input
                    name="listing[location]"
                    placeholder="Enter location"
                    type="text"
                    class="form-control"
                    required
                />
                 <div class="invalid-feedback">
        Please enter a location.
            </div>
           
    </div>


            <!-- Submit -->
            <button class="btn btn-primary">Add Listing</button>

        </form>

    </div>
</div>